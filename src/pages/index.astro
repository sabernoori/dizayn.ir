---
import Layout from "../layouts/Layout.astro";

const whatsapp = "https://wa.me/989120295053";
---

<Layout>
  <main>
    <img class="logo" src="/images/logo.svg" width="242" height="60" alt="دیزاین" />
    <div class="copy">
      <hr />
      <h1>منتظر سایت جدید ما باشید...</h1>
      <hr />
      <p>
        جهت مشاوره طراحی و توسعه وبسایت و اپلیکیشن یا برندینگ و هویت بصری
        می‌توانید با ما در ارتباط باشید. جهت دیدن نمونه‌کارها پیام بفرستید...
      </p>
    </div>
    <a class="cta" href={whatsapp} target="_blank" rel="noopener noreferrer">
      <img src="/icons/whatsapp.svg" width="20" height="20" alt="" />
      <span class="phone">۰۹۱۲۰۲۹۵۰۵۳</span>
      <span class="divider" aria-hidden="true"></span>
      <span class="label">مشاوره<br />رایـــگان</span>
    </a>
  </main>
</Layout>

<style>
  main {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2rem, 5vh, 3.25rem);
    padding: 2.5rem 1.25rem 3rem;
  }

  .logo {
    width: min(242px, 70vw);
    height: auto;
  }

  .copy {
    width: min(765px, 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.5rem, 4vh, 3.25rem);
    text-align: center;
  }

  hr {
    width: min(754px, 98%);
    border: 0;
    border-top: 1px solid var(--line);
    margin: 0;
  }

  h1 {
    margin: 0;
    font-family: "Abar Low", Tahoma, sans-serif;
    font-size: clamp(1.75rem, 4.25vw, 3.82rem);
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0;
  }

  p {
    margin: 0;
    max-width: 46rem;
    font-family: "Abar Low", Tahoma, sans-serif;
    font-size: clamp(1rem, 1.7vw, 1.5rem);
    font-weight: 400;
    line-height: 1.7;
    opacity: 0.8;
  }

  .cta {
    font-family: "Abar Low", Tahoma, sans-serif;
    font-weight: 800;
    direction: ltr;
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 0.7rem;
    height: 56px;
    padding: 0 0.85rem 0 1rem;
    background: #fff;
    border-radius: 12px;
    text-decoration: none;
  }

  .cta:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .phone {
    font-size: 1.0625rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .divider {
    width: 1px;
    height: 28px;
    background: #d5d5d5;
  }

  .label {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1.4;
    text-align: center;
  }
</style>
